# ==============================================================================
# ORBIT — Geospatial Intelligence & Earth Monitoring Platform
# Local-First Environment Configuration Template (.env.example)
# ==============================================================================

# --- Application Environment ---
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME=ORBIT-Intelligence-Platform
API_V1_STR=/api/v1
SECRET_KEY=orbit-dev-insecure-key-change-in-production-minimum-32-chars

# --- Security & Network Isolation ---
ALLOW_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
SSRF_PROTECTION_ENABLED=true
RASTER_MAX_DIMENSION=16384
RASTER_MAX_MEM_BYTES=268435456

# --- PostgreSQL 16 + PostGIS 3.4 Database ---
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=orbit_user
POSTGRES_PASSWORD=orbit_password
POSTGRES_DB=orbit_db
DATABASE_URL=postgresql+asyncpg://orbit_user:orbit_password@localhost:5432/orbit_db

# --- Redis 7.2 Cache & Celery Broker ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Earth Observation & STAC Providers ---
# --- Earth Observation & STAC Providers ---
STAC_EARTH_SEARCH_URL=https://earth-search.aws.element84.com/v1
STAC_REQUEST_TIMEOUT_SECONDS=15
STAC_MAX_RETRIES=3

# --- Frontend Basemap Provider (MapTiler) ---
# Obtain key at: https://cloud.maptiler.com/account/keys/
VITE_MAPTILER_API_KEY=

# --- AI Intelligence Synthesis Provider ---
# Options: MOCK (default offline), OPENAI, ANTHROPIC, GEMINI, OLLAMA
ORBIT_AI_PROVIDER=MOCK
ORBIT_AI_API_KEY=
ORBIT_AI_MODEL=orbit-grounded-reasoner-v1

# --- Storage & Artifacts ---
ORBIT_DATA_DIR=./data
ORBIT_REPORTS_DIR=./data/reports
ORBIT_RASTER_CACHE_DIR=./data/cache/rasters
